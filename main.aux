\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Train vs.\ test ROC-AUC comparison across all seven models, serving as an overfitting diagnostic. The near-identical bar heights for all gradient-boosted models and ensembles (gap $<$0.03) indicate strong generalization to the held-out 2024--2025 test period. No model exceeds the overfitting flag threshold of a 0.05 AUC gap, confirming robustness of the temporal validation protocol.}}{23}{figure.11}\protected@file@percent }
\newlabel{fig:train_test_auc}{{11}{23}{Train vs.\ test ROC-AUC comparison across all seven models, serving as an overfitting diagnostic. The near-identical bar heights for all gradient-boosted models and ensembles (gap $<$0.03) indicate strong generalization to the held-out 2024--2025 test period. No model exceeds the overfitting flag threshold of a 0.05 AUC gap, confirming robustness of the temporal validation protocol}{figure.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Spatial Leakage Quantification: Leave-One-Zone-Out Cross-Validation}{23}{subsection.2.4}\protected@file@percent }
\newlabel{sec:spatial_cv}{{2.4}{23}{Spatial Leakage Quantification: Leave-One-Zone-Out Cross-Validation}{subsection.2.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Leave-One-Zone-Out (LOZO) cross-validation results vs.\ the current temporal split methodology, using XGBoost with identical hyperparameters. Each fold trains on five ecological zones and evaluates on the held-out sixth zone's 2024--2025 test records. The average LOZO-CV AUC of 0.8486 (vs.\ 0.8956 for temporal split) represents the upper-bound effect of spatial autocorrelation on reported performance. The $\Delta $AUC of $-0.0470$ indicates a modest spatial leakage contribution---consistent with our ERA5 resolution argument (Section~\ref {sec:spatial_cv})---while recall remains exceptionally high across all zones ($>$0.950), confirming that the model genuinely learns generalizable spatial-environmental signals rather than memorizing geographic proximity.}}{24}{table.6}\protected@file@percent }
\newlabel{tab:spatial_cv}{{6}{24}{Leave-One-Zone-Out (LOZO) cross-validation results vs.\ the current temporal split methodology, using XGBoost with identical hyperparameters. Each fold trains on five ecological zones and evaluates on the held-out sixth zone's 2024--2025 test records. The average LOZO-CV AUC of 0.8486 (vs.\ 0.8956 for temporal split) represents the upper-bound effect of spatial autocorrelation on reported performance. The $\Delta $AUC of $-0.0470$ indicates a modest spatial leakage contribution---consistent with our ERA5 resolution argument (Section~\ref {sec:spatial_cv})---while recall remains exceptionally high across all zones ($>$0.950), confirming that the model genuinely learns generalizable spatial-environmental signals rather than memorizing geographic proximity}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Operational Decision Threshold Calibration}{24}{subsection.2.5}\protected@file@percent }
\newlabel{sec:thresholds}{{2.5}{24}{Operational Decision Threshold Calibration}{subsection.2.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.6}Static vs.\ Dynamic Feature Contribution}{24}{subsection.2.6}\protected@file@percent }
\newlabel{sec:static_dynamic}{{2.6}{24}{Static vs.\ Dynamic Feature Contribution}{subsection.2.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Static vs.\ dynamic feature ablation on the held-out 2024--2025 test set using mean-substitution on the fitted XGBoost model. Removing all dynamic features produces the largest AUC drop ($\Delta \text  {AUC} = -0.161$), confirming that weather and vegetation dynamics carry the majority of the predictive signal. Within dynamic features, Meteorology ($\Delta \text  {AUC} = -0.051$) and Temporal encoding ($\Delta \text  {AUC} = -0.032$) contribute most. Among static features, Elevation dominates ($\Delta \text  {Recall} = -0.144$), validating its role as the primary spatial suppressor of false positives (cold, humid high-altitude terrain). Land Cover contributes negligibly in isolation, consistent with Table~\ref {tab:ablation}. Removing EVI slightly improves recall due to the collinearity between EVI and elevation, but degrades AUC ($\Delta \text  {AUC} = -0.030$) and sharply increases calibration error (Brier: $0.078 \to 0.126$).}}{25}{table.7}\protected@file@percent }
\newlabel{tab:static_dynamic}{{7}{25}{Static vs.\ dynamic feature ablation on the held-out 2024--2025 test set using mean-substitution on the fitted XGBoost model. Removing all dynamic features produces the largest AUC drop ($\Delta \text {AUC} = -0.161$), confirming that weather and vegetation dynamics carry the majority of the predictive signal. Within dynamic features, Meteorology ($\Delta \text {AUC} = -0.051$) and Temporal encoding ($\Delta \text {AUC} = -0.032$) contribute most. Among static features, Elevation dominates ($\Delta \text {Recall} = -0.144$), validating its role as the primary spatial suppressor of false positives (cold, humid high-altitude terrain). Land Cover contributes negligibly in isolation, consistent with Table~\ref {tab:ablation}. Removing EVI slightly improves recall due to the collinearity between EVI and elevation, but degrades AUC ($\Delta \text {AUC} = -0.030$) and sharply increases calibration error (Brier: $0.078 \to 0.126$)}{table.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.7}Stacking Ensemble Detailed Evaluation}{25}{subsection.2.7}\protected@file@percent }
