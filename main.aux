\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces ROC curves for all seven candidate models evaluated on the held-out 2024--2025 test set. Logistic Regression (AUC~=~0.8832) serves as the linear baseline. All gradient-boosted models and ensembles cluster between AUC~=~0.9515 and AUC~=~0.9571, with XGBoost achieving the highest discriminative power. The dashed diagonal represents random-chance performance (AUC~=~0.5).}}{19}{figure.8}\protected@file@percent }
\newlabel{fig:roc_all}{{8}{19}{ROC curves for all seven candidate models evaluated on the held-out 2024--2025 test set. Logistic Regression (AUC~=~0.8832) serves as the linear baseline. All gradient-boosted models and ensembles cluster between AUC~=~0.9515 and AUC~=~0.9571, with XGBoost achieving the highest discriminative power. The dashed diagonal represents random-chance performance (AUC~=~0.5)}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Precision-Recall curves for all seven candidate models on the 2024--2025 test set. The PR curve is particularly informative under class imbalance because it highlights performance on the rare fire class. XGBoost achieves the highest PR-AUC (0.9433), followed by LightGBM (0.9375). The Logistic Regression baseline (PR-AUC~=~0.8327) is clearly separated, illustrating the benefit of nonlinear modeling for this task.}}{20}{figure.9}\protected@file@percent }
\newlabel{fig:pr_all}{{9}{20}{Precision-Recall curves for all seven candidate models on the 2024--2025 test set. The PR curve is particularly informative under class imbalance because it highlights performance on the rare fire class. XGBoost achieves the highest PR-AUC (0.9433), followed by LightGBM (0.9375). The Logistic Regression baseline (PR-AUC~=~0.8327) is clearly separated, illustrating the benefit of nonlinear modeling for this task}{figure.9}{}}
\citation{vanWagner1987}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Model AUC ranking on the held-out test set, ordered from highest to lowest ROC-AUC. Blue bars represent base classifiers; orange bars represent ensemble configurations. XGBoost achieves the highest test AUC among base models (0.9571). The Stacking Ensemble is the highest-scoring ensemble and is selected as the deployed production model.}}{21}{figure.10}\protected@file@percent }
\newlabel{fig:auc_rank}{{10}{21}{Model AUC ranking on the held-out test set, ordered from highest to lowest ROC-AUC. Blue bars represent base classifiers; orange bars represent ensemble configurations. XGBoost achieves the highest test AUC among base models (0.9571). The Stacking Ensemble is the highest-scoring ensemble and is selected as the deployed production model}{figure.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Complete performance comparison of all candidate models on the held-out 2024--2025 test set (1,577,270 records), ranked by test ROC-AUC. Boldface indicates the best value per column ($\star $~=~selected production model). ERA5 weather features are lagged by one day relative to the fire label, implementing a genuine next-day forecasting horizon. PR-AUC and Brier Score are reported in addition to standard metrics; PR-AUC is especially informative under class imbalance as it focuses entirely on the positive (fire) class. XGBoost achieves the highest ROC-AUC (0.9571), PR-AUC (0.9433), and lowest Brier score (0.0770). The Stacking Ensemble is selected as the production model for its superior precision (0.8871). $^\dagger $The FWI baseline was computed on a 500-cell representative subsample of test grid cells using the van Wagner (1987) equation cascade; precipitation was set to 0~mm/day (unavailable in the feature set), slightly overestimating FWI scores. Despite achieving near-perfect recall (0.977) at its Youden's~J threshold, the FWI ROC-AUC of 0.374 demonstrates that fire-season drying indices alone lack the spatial discriminative power needed at a continental scale.}}{21}{table.5}\protected@file@percent }
\newlabel{tab:model_results}{{5}{21}{Complete performance comparison of all candidate models on the held-out 2024--2025 test set (1,577,270 records), ranked by test ROC-AUC. Boldface indicates the best value per column ($\star $~=~selected production model). ERA5 weather features are lagged by one day relative to the fire label, implementing a genuine next-day forecasting horizon. PR-AUC and Brier Score are reported in addition to standard metrics; PR-AUC is especially informative under class imbalance as it focuses entirely on the positive (fire) class. XGBoost achieves the highest ROC-AUC (0.9571), PR-AUC (0.9433), and lowest Brier score (0.0770). The Stacking Ensemble is selected as the production model for its superior precision (0.8871). $^\dagger $The FWI baseline was computed on a 500-cell representative subsample of test grid cells using the van Wagner (1987) equation cascade; precipitation was set to 0~mm/day (unavailable in the feature set), slightly overestimating FWI scores. Despite achieving near-perfect recall (0.977) at its Youden's~J threshold, the FWI ROC-AUC of 0.374 demonstrates that fire-season drying indices alone lack the spatial discriminative power needed at a continental scale}{table.5}{}}
