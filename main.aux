\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Expected Calibration Error (ECE) before and after Isotonic Regression post-calibration for all seven models, evaluated on the held-out 2024--2025 test set (1,577,270 records). Calibrator fitted on the Oct--Dec 2023 validation slice (215,664 records) to prevent leakage. Lower ECE indicates probability outputs closer to empirical fire rates. Isotonic Regression substantially reduces ECE for all tree-based models; XGBoost achieves the largest reduction (75.1\%). \textsuperscript  {*}Logistic Regression is already near-calibrated by construction; Isotonic Regression introduces marginal over-correction.}}{30}{table.8}\protected@file@percent }
\newlabel{tab:calibration}{{8}{30}{Expected Calibration Error (ECE) before and after Isotonic Regression post-calibration for all seven models, evaluated on the held-out 2024--2025 test set (1,577,270 records). Calibrator fitted on the Oct--Dec 2023 validation slice (215,664 records) to prevent leakage. Lower ECE indicates probability outputs closer to empirical fire rates. Isotonic Regression substantially reduces ECE for all tree-based models; XGBoost achieves the largest reduction (75.1\%). \textsuperscript {*}Logistic Regression is already near-calibrated by construction; Isotonic Regression introduces marginal over-correction}{table.8}{}}
