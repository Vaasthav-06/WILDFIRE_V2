# ==============================================================================
# WILDFIRE RISK PREDICTION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your personal API credentials.
# DO NOT commit real secrets to source control.
# ==============================================================================

# Google Gemini API Key (used for SHAP narrative synthesis and conversational chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# NASA FIRMS MAP_KEY / API Key (used for real-time active fire synchronization)
# Obtain from https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=your_nasa_firms_map_key_here

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
